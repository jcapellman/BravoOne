<Page
    x:Class="BravoOne.UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BravoOne.UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="using:BravoOne.UWP.ViewModels"
    mc:Ignorable="d"
    >

    <Grid Background="{StaticResource AppBg}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header Row — command strip -->
        <Grid Grid.Row="0" Padding="16,10,16,10" Background="{StaticResource PanelBg}"
              BorderBrush="{StaticResource AmberBorder}" BorderThickness="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Logo + team name -->
            <Image Grid.Column="0" Width="52" Height="52" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center">
                <Image.Source>
                    <BitmapImage UriSource="{Binding gWrapper.CurrentGame.TeamLogo}" />
                </Image.Source>
            </Image>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Header}" Text="BRAVO ONE  //  HQ SITREP" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}" Text="CO: " />
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberPrimary}"
                               Text="{Binding gWrapper.CurrentGame.TeamLeaderName}" />
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}" Text="   CLEARANCE LVL " Margin="16,0,0,0" />
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource PhosphorGreen}"
                               Text="{Binding gWrapper.CurrentGame.TeamLevel}" />
                </StackPanel>
            </StackPanel>

            <!-- Date + funds — right-aligned -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Style="{StaticResource Header}" HorizontalAlignment="Right"
                           Text="{Binding gWrapper.CurrentGame.CurrentDateString}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}" Text="FUNDS  $" />
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource PhosphorGreen}"
                               Text="{Binding gWrapper.CurrentGame.Money}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Content Row — three panels -->
        <Grid Grid.Row="1" Margin="16,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── PANEL 1: Team Roster ── -->
            <Grid Grid.Column="0" Padding="14,12,14,12"
                  Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource SubHeader}" Text="TEAM ROSTER" Foreground="{StaticResource AmberPrimary}" />
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}"
                               Margin="10,0,0,0" Text="{Binding TeamMembers.Count}" />
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}" Text=" operators" />
                </StackPanel>

                <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{Binding TeamMembers}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,3,0,3"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6" Padding="10,8,10,8"
                                  Background="{StaticResource ItemBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Name -->
                                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" FontSize="14"
                                           FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                           Foreground="{StaticResource AmberPrimary}" Text="{Binding Name}" />

                                <!-- Specialty + skill -->
                                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,2,0,4">
                                    <TextBlock Style="{StaticResource FieldHeader}" Text="{Binding Specialty}" />
                                    <TextBlock Style="{StaticResource FieldValue}" Foreground="{StaticResource ColdBlue}"
                                               Margin="8,0,0,0" Text="SP " />
                                    <TextBlock Style="{StaticResource FieldValue}" Foreground="{StaticResource ColdBlue}"
                                               Text="{Binding SkillPoints}" />
                                </StackPanel>

                                <!-- Health bar -->
                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Vertical" Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FieldHeader}" Text="HEALTH  " />
                                        <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Health}" />
                                    </StackPanel>
                                    <ProgressBar Height="4" Minimum="0" Maximum="100"
                                                 Value="{Binding Health}"
                                                 Foreground="{StaticResource PhosphorGreen}" />
                                </StackPanel>

                                <!-- Salary -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldHeader}" Text="SALARY  $" />
                                    <TextBlock Style="{StaticResource FieldValue}" Foreground="{StaticResource AlertRed}"
                                               Text="{Binding MonthlySalary}" />
                                </StackPanel>

                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                        VerticalAlignment="Top" HorizontalAlignment="Right"
                                        Content="ASSIGN" Click="btnManageTeamMember_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ── PANEL 2: Active Contracts ── -->
            <Grid Grid.Column="2" Padding="14,12,14,12"
                  Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SubHeader}" Margin="0,0,0,10"
                           Text="ACTIVE CONTRACTS" />

                <ListView Grid.Row="1" SelectionMode="None"
                          ItemsSource="{Binding gWrapper.CurrentGame.Contracts}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,3,0,3"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8" Padding="10,8,10,8"
                                          Background="{StaticResource ItemBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Name + type -->
                                        <Grid Grid.Row="0" Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="14"
                                                       FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                       Foreground="{StaticResource AmberPrimary}" Text="{Binding Name}" />
                                            <Border Grid.Column="1" Background="#CC1A0A00"
                                                    Padding="8,2,8,2" VerticalAlignment="Center"
                                                    BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                                <TextBlock Foreground="{StaticResource AmberDim}" FontSize="10" FontWeight="Bold"
                                                           FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                           Text="{Binding CType}" />
                                            </Border>
                                        </Grid>

                                <!-- Progress bar -->
                                <StackPanel Grid.Row="1" Margin="0,4,0,2">
                                    <TextBlock Style="{StaticResource FieldHeader}" Text="PROGRESS" Margin="0,0,0,2" />
                                    <ProgressBar Height="6" Minimum="0"
                                                 Maximum="{Binding SkillPointsTotal}"
                                                 Value="{Binding SkillPointsCompleted}"
                                                 Foreground="{StaticResource PhosphorGreen}" />
                                </StackPanel>

                                <!-- Payout + deadline -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,2">
                                    <TextBlock Style="{StaticResource FieldHeader}" Text="PAYOUT  $" />
                                    <TextBlock Style="{StaticResource FieldValue}" Foreground="{StaticResource PhosphorGreen}"
                                               Text="{Binding Income}" Margin="4,0,16,0" />
                                    <TextBlock Style="{StaticResource FieldHeader}" Text="STATUS  " />
                                    <TextBlock Style="{StaticResource FieldValue}" Foreground="{StaticResource AmberPrimary}"
                                               Text="{Binding Status}" />
                                </StackPanel>

                                <!-- Complete date -->
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource FieldHeader}" Text="DEADLINE  " />
                                    <TextBlock Style="{StaticResource FieldValue}" Foreground="{StaticResource AmberDim}"
                                               Text="{Binding CompleteDate}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Shortcut to contracts screen -->
                <Button Grid.Row="2" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                        Style="{ThemeResource MainButton}" Content="View Available Contracts"
                        Click="btnContracts_Click" />
            </Grid>

            <!-- ── PANEL 3: Activity Log ── -->
            <Grid Grid.Column="4" Padding="14,12,14,12"
                  Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SubHeader}" Margin="0,0,0,10"
                           Text="INTEL FEED" />

                <ListView Grid.Row="1" SelectionMode="None"
                          ItemsSource="{Binding gWrapper.CurrentGame.Activities}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,3,0,3"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8" Padding="10,8,10,8"
                                  Background="{StaticResource ItemBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="3"
                                       Width="36" Height="36" Margin="0,0,10,0"
                                       VerticalAlignment="Top">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding IconImagePath}" />
                                    </Image.Source>
                                </Image>

                                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" FontSize="13"
                                           FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                           Foreground="{StaticResource AmberPrimary}" Text="{Binding Title}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12"
                                           Foreground="{StaticResource AmberDim}" TextWrapping="Wrap"
                                           Text="{Binding Detail}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11"
                                           Foreground="{StaticResource PhosphorGreen}" Text="{Binding TimeStamp}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Footer Row — nav buttons -->
        <Grid Grid.Row="2" Padding="16,8,16,12"
              Background="{StaticResource PanelBg}"
              BorderBrush="{StaticResource AmberBorder}" BorderThickness="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0">
                <Button Style="{ThemeResource MainButton}" Content="RECRUITMENT"
                        Margin="0,0,12,0" Click="btnRecruitment_Click" />
                <Button Style="{ThemeResource MainButton}" Content="EQUIPMENT"
                        Margin="0,0,12,0" Click="btnEquipment_Click" />
                <Button Style="{ThemeResource MainButton}" Content="CONTRACTS"
                        Margin="0,0,12,0" Click="btnContracts_Click" />
                <Button Style="{ThemeResource MainButton}" Content="GAME OPTIONS" Margin="0,0,12,0">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="Save Game" Click="btnSaveGame_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Exit Game" Click="btnExitGame_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Button Grid.Column="1" Content="END MONTH  ▶"
                    Click="btnEndMonth_Click" Style="{ThemeResource MainButton}" />
        </Grid>

        <!-- CRT scanline overlay -->
        <Rectangle IsHitTestVisible="False" Grid.RowSpan="3" Opacity="0.28">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.05" SpreadMethod="Repeat">
                    <GradientStop Color="#33000000" Offset="0.0" />
                    <GradientStop Color="#33000000" Offset="0.49" />
                    <GradientStop Color="#00000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</Page>