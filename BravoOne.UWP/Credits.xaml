<Page
    x:Class="BravoOne.UWP.Credits"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BravoOne.UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBg}">
        <Grid Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,10,16,10" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="0,0,0,2">
                <TextBlock Text="PERSONNEL FILE" Style="{StaticResource Header}" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,16,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" x:Name="gCredits" Margin="0,800,20,0" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" HorizontalAlignment="Center"
                               Text="PROGRAMMING &amp; DESIGN" Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}" />
                    <TextBlock Grid.Row="1" HorizontalAlignment="Center"
                               Text="JARRED CAPELLMAN" Style="{StaticResource Header}" Foreground="{StaticResource AmberPrimary}" />

                    <TextBlock Grid.Row="2" Margin="0,40,0,0" HorizontalAlignment="Center"
                               Text="QUALITY ASSURANCE" Style="{StaticResource SubHeader}" Foreground="{StaticResource AmberDim}" />
                    <TextBlock Grid.Row="3" HorizontalAlignment="Center"
                               Text="NOPHIL ANWER" Style="{StaticResource Header}" Foreground="{StaticResource AmberPrimary}" />
                </Grid>

                <Grid Grid.Column="1" HorizontalAlignment="Right">
                    <Image Source="Assets/SidePanels/Satellite.png" Stretch="Uniform" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Padding="16,10,16,10">
                <Button Content="BACK TO MAIN MENU" Click="btnBack_Click" Style="{StaticResource MainButton}" />
            </Grid>
        </Grid>

        <Rectangle IsHitTestVisible="False" Grid.RowSpan="3" Opacity="0.28">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.05" SpreadMethod="Repeat">
                    <GradientStop Color="#33000000" Offset="0.0" />
                    <GradientStop Color="#33000000" Offset="0.49" />
                    <GradientStop Color="#00000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</Page>
