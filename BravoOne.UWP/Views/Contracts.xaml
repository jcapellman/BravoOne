<Page
    x:Class="BravoOne.UWP.Views.Contracts"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BravoOne.UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       mc:Ignorable="d">

    <Grid>
        <Grid>
            <Grid.Background>
                <ImageBrush ImageSource="../Assets/Backgrounds/Camo.png" />
            </Grid.Background>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Header}" Text="AVAILABLE CONTRACTS" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource SubHeader}" Foreground="#FF88FF88"
                               Text="{Binding AvailableContracts.Count}" />
                    <TextBlock Style="{StaticResource SubHeader}" Text=" contracts on the board" />
                </StackPanel>
            </Grid>

            <!-- Content: available left, active right -->
            <Grid Grid.Row="1" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Available Contracts list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SubHeader}" Foreground="#FFAADDFF"
                               Margin="0,0,0,8" Text="OPEN CONTRACTS  —  hire specialists then accept" />
                    <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{Binding AvailableContracts}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0,3,0,3"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10" Padding="16,14,16,14" CornerRadius="10">
                                    <Grid.Background>
                                        <SolidColorBrush Color="Black" Opacity="0.65" />
                                    </Grid.Background>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Name + type badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource ListViewHeader}"
                                                   Text="{Binding Contract.Name}" />
                                        <Border Grid.Column="1" Background="#CC102010" CornerRadius="4"
                                                Padding="10,3,10,3" VerticalAlignment="Center">
                                            <TextBlock Foreground="#FF88FF88" FontSize="11" FontWeight="Bold"
                                                       Text="{Binding Contract.CType}" />
                                        </Border>
                                    </Grid>

                                    <!-- Briefing -->
                                    <TextBlock Grid.Row="1" Margin="0,6,0,10" TextWrapping="Wrap"
                                               Foreground="#FFD0D0D0" FontSize="13" FontStyle="Italic"
                                               Text="{Binding Contract.Briefing}" />

                                    <!-- Payout / Penalty / Window -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Style="{StaticResource FieldHeader}" Text="PAYOUT " />
                                        <TextBlock Style="{StaticResource FieldValue}" Foreground="#FF88FF88"
                                                   Text="{Binding Contract.Income}" Margin="4,0,20,0" />
                                        <TextBlock Style="{StaticResource FieldHeader}" Text="PENALTY " />
                                        <TextBlock Style="{StaticResource FieldValue}" Foreground="#FFFF6666"
                                                   Text="{Binding Contract.Penalty}" Margin="4,0,20,0" />
                                        <TextBlock Style="{StaticResource FieldHeader}" Text="WINDOW " />
                                        <TextBlock Style="{StaticResource FieldValue}" Foreground="#FFFFCC44"
                                                   Text="{Binding DeadlineLabel}" Margin="4,0,0,0" />
                                    </StackPanel>

                                    <!-- Required specialists -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Style="{StaticResource FieldHeader}" Text="REQUIRES  " />
                                        <TextBlock Style="{StaticResource FieldValue}" Foreground="#FFAADDFF"
                                                   Text="{Binding SpecialtiesLabel}" />
                                    </StackPanel>

                                    <!-- Accept -->
                                    <Button Grid.Row="4" HorizontalAlignment="Left"
                                            Style="{StaticResource MainButton}"
                                            IsEnabled="{Binding CanAccept}"
                                            Content="{Binding AcceptLabel}"
                                            Click="btnAccept_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Active contracts sidebar -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{StaticResource SubHeader}" Foreground="#FFFFCC44"
                               Margin="0,0,0,8" Text="ACTIVE CONTRACTS" />
                    <ListView Grid.Row="1" SelectionMode="None" ItemsSource="{Binding ActiveContracts}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,8" Padding="12,10,12,10" CornerRadius="8">
                                    <Grid.Background>
                                        <SolidColorBrush Color="#0D1A00" Opacity="0.9" />
                                    </Grid.Background>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource ListViewHeader}"
                                               Text="{Binding Contract.Name}" />
                                    <TextBlock Grid.Row="1" Margin="0,2,0,4" FontSize="11"
                                               Foreground="#FF888888" Text="{Binding Contract.CType}" />
                                    <ProgressBar Grid.Row="2" Margin="0,0,0,4" Height="6"
                                                 Minimum="0" Maximum="{Binding Contract.SkillPointsTotal}"
                                                 Value="{Binding Contract.SkillPointsRemaining}"
                                                 Foreground="#FF44AA44" />
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldValue}"
                                                   Foreground="#FFB0B0B0" Text="{Binding SpecialtiesLabel}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldValue}"
                                                   Foreground="#FFFFCC44" Text="{Binding DeadlineLabel}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Button Grid.Row="2" Margin="16,8,0,12" Style="{ThemeResource MainButton}"
                    Content="Return to Main Screen" Click="btnBack_Click" />
        </Grid>
    </Grid>
</Page>