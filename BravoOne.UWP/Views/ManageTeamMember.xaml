<Page
    x:Class="BravoOne.UWP.Views.ManageTeamMember"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BravoOne.UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBg}">
        <Grid Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="16,10,16,10"
              Background="{StaticResource PanelBg}"
              BorderBrush="{StaticResource AmberBorder}" BorderThickness="0,0,0,2">
            <TextBlock Style="{StaticResource Header}" Text="OPERATOR MANAGEMENT" />
        </Grid>

        <!-- Tab pivot -->
        <Pivot Grid.Row="1" Margin="16,8,16,0">

            <!-- ══════════════════════════════════════════════════
                 TAB 1 — CONTRACT ASSIGNMENTS
            ══════════════════════════════════════════════════ -->
            <PivotItem Header="CONTRACT ASSIGNMENTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding ContractAssignments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,20" Padding="16,14,16,14"
                                      Background="{StaticResource ItemBg}"
                                      BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><!-- title row -->
                                        <RowDefinition Height="Auto" /><!-- requirement badges -->
                                        <RowDefinition Height="Auto" /><!-- progress -->
                                        <RowDefinition Height="Auto" /><!-- assigned names strip -->
                                        <RowDefinition Height="Auto" /><!-- separator -->
                                        <RowDefinition Height="Auto" /><!-- operator table header -->
                                        <RowDefinition Height="Auto" /><!-- operator rows -->
                                    </Grid.RowDefinitions>

                                    <!-- ── Row 0: Mission name / type / deadline ── -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource ListViewHeader}"
                                                   Text="{Binding Contract.Name}" />
                                        <Border Grid.Column="1" Background="#CC1A0A00" Margin="8,0,8,0"
                                                Padding="8,2,8,2" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                            <TextBlock Foreground="{StaticResource AmberDim}" FontSize="11" FontWeight="Bold"
                                                       FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                       Text="{Binding Contract.CType}" />
                                        </Border>
                                        <Border Grid.Column="2" Background="#CC1A0A00"
                                                Padding="8,2,8,2" VerticalAlignment="Center"
                                                BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                            <TextBlock Foreground="{StaticResource AmberPrimary}" FontSize="11" FontWeight="Bold"
                                                       FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                       Text="{Binding DeadlineLabel}" />
                                        </Border>
                                    </Grid>

                                    <!-- ── Row 1: Required specialty badges (filled=green, missing=red) ── -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FieldHeader}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   Text="REQUIRES" />
                                        <ItemsControl ItemsSource="{Binding RequirementSlots}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,6,0" Padding="8,3,8,3"
                                                            BorderThickness="1"
                                                            BorderBrush="{Binding FilledBorderColor}">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#CC110800" />
                                                        </Border.Background>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                                       FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                                       Foreground="{Binding FilledColor}"
                                                                       Text="{Binding FilledIcon}"
                                                                       Margin="0,0,4,0" />
                                                            <TextBlock FontSize="11" FontWeight="Bold"
                                                                       FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                                       Foreground="{Binding FilledColor}"
                                                                       Text="{Binding Label}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- ── Row 2: Progress bar ── -->
                                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Style="{StaticResource FieldHeader}" Text="PROGRESS  " />
                                            <TextBlock Style="{StaticResource FieldValue}"
                                                       Foreground="{StaticResource PhosphorGreen}"
                                                       Text="{Binding SkillPointsCompleted}" />
                                            <TextBlock Style="{StaticResource FieldValue}"
                                                       Foreground="{StaticResource AmberBorder}" Text=" / " />
                                            <TextBlock Style="{StaticResource FieldValue}"
                                                       Foreground="{StaticResource AmberDim}"
                                                       Text="{Binding Contract.SkillPointsTotal}" />
                                            <TextBlock Style="{StaticResource FieldValue}"
                                                       Foreground="{StaticResource AmberBorder}" Text=" SP" />
                                        </StackPanel>
                                        <ProgressBar Height="6" Minimum="0"
                                                     Maximum="{Binding Contract.SkillPointsTotal}"
                                                     Value="{Binding SkillPointsCompleted}"
                                                     Foreground="{StaticResource PhosphorGreen}" />
                                    </StackPanel>

                                    <!-- ── Row 3: Assigned operators name strip ── -->
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FieldHeader}"
                                                   Margin="0,0,10,0" Text="ASSIGNED" />
                                        <TextBlock Style="{StaticResource FieldValue}"
                                                   Foreground="{StaticResource ColdBlue}"
                                                   Text="{Binding AssignedNames}" />
                                        <TextBlock Style="{StaticResource FieldHeader}"
                                                   Foreground="{StaticResource AmberBorder}"
                                                   Margin="10,0,0,0"
                                                   Text="{Binding AssignedCount}" />
                                        <TextBlock Style="{StaticResource FieldHeader}"
                                                   Foreground="{StaticResource AmberBorder}"
                                                   Text=" operators" />
                                    </StackPanel>

                                    <!-- ── Row 4: Separator ── -->
                                    <Rectangle Grid.Row="4" Height="1"
                                               Fill="{StaticResource AmberBorder}" Margin="0,0,0,8" />

                                    <!-- ── Row 5: Operator table column headers ── -->
                                    <Grid Grid.Row="5" Margin="0,0,0,4" Padding="10,4,10,4"
                                          Background="{StaticResource AppBg}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource FieldHeader}" Text="OPERATOR" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldHeader}" Text="SPECIALTY" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource FieldHeader}" Text="SP" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource FieldHeader}" Text="HP" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource FieldHeader}" Text="" />
                                    </Grid>

                                    <!-- ── Row 6: Operator rows ── -->
                                    <ItemsControl Grid.Row="6" ItemsSource="{Binding Members}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,3" Padding="10,7,10,7"
                                                      Background="{Binding RowBackground}"
                                                      BorderBrush="{Binding RowBorderColor}" BorderThickness="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="120" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Name -->
                                                    <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                               Foreground="{StaticResource AmberPrimary}"
                                                               Text="{Binding Member.Name}" />
                                                    <!-- Specialty + match indicator -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource FieldHeader}"
                                                                   Text="{Binding Member.Specialty}" />
                                                        <TextBlock FontSize="10" FontWeight="Bold"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                                   Foreground="{StaticResource PhosphorGreen}"
                                                                   Margin="4,0,0,0"
                                                                   Text="{Binding SpecialtyMatchLabel}" />
                                                    </StackPanel>
                                                    <!-- SP -->
                                                    <TextBlock Grid.Column="2" Style="{StaticResource FieldValue}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource ColdBlue}"
                                                               Text="{Binding Member.SkillPoints}" />
                                                    <!-- HP -->
                                                    <TextBlock Grid.Column="3" Style="{StaticResource FieldValue}"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Member.Health}" />
                                                    <!-- Assign/Remove button -->
                                                    <Button Grid.Column="4" HorizontalAlignment="Stretch"
                                                            Content="{Binding ButtonLabel}"
                                                            Style="{StaticResource MainButton}"
                                                            Click="btnToggleAssignment_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>

            <!-- ══════════════════════════════════════════════════
                 TAB 2 — EQUIPMENT ASSIGNMENT
            ══════════════════════════════════════════════════ -->
            <PivotItem Header="EQUIPMENT">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding OperatorEquipment}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One card per operator -->
                                <Grid Margin="0,0,0,16" Padding="16,14,16,14" Background="{StaticResource ItemBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Operator name + specialty -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource ListViewHeader}"
                                                   Text="{Binding Member.Name}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource FieldHeader}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Text="{Binding Member.Specialty}" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Style="{StaticResource FieldHeader}" Text="HP " />
                                            <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Member.Health}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource FieldHeader}" Text="SP " />
                                            <TextBlock Style="{StaticResource FieldValue}"
                                                       Foreground="#FFAADDFF" Text="{Binding Member.SkillPoints}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Currently assigned gear -->
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldHeader}"
                                               Margin="0,0,0,6" Text="ASSIGNED GEAR" />
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding AssignedSlots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4" Padding="10,6,10,6"
                                                      Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="13"
                                                               FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                               Foreground="{StaticResource AmberPrimary}" VerticalAlignment="Center"
                                                               Text="{Binding EquipmentName}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldHeader}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               Text="CONDITION  " />
                                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,16,0"
                                                               Foreground="{Binding ConditionColor}"
                                                               Text="{Binding ConditionLabel}" />
                                                    <Button Grid.Column="3" Content="REMOVE"
                                                            Style="{StaticResource MainButton}"
                                                            Click="btnUnassignEquipment_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource AmberBorder}" Margin="0,8,0,8" />

                                    <!-- Pool gear available to assign -->
                                    <ItemsControl Grid.Row="4" ItemsSource="{Binding PoolItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4" Padding="10,6,10,6"
                                                      Background="{StaticResource ItemBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontWeight="Bold" FontSize="13"
                                                               FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                               Foreground="{StaticResource AmberDim}" VerticalAlignment="Center"
                                                               Text="{Binding Equipment.Name}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource FieldHeader}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Text="{Binding Equipment.EType}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Style="{StaticResource FieldHeader}" Text="DMG " />
                                                        <TextBlock Style="{StaticResource FieldValue}"
                                                                   Foreground="#FFFF9944" Text="{Binding Equipment.Damage}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Style="{StaticResource FieldHeader}" Text="REL " />
                                                        <TextBlock Style="{StaticResource FieldValue}"
                                                                   Text="{Binding Equipment.Reliability}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="Bold"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               FontFamily="Fonts/MainFont.ttf#Tudor Victors"
                                                               Foreground="{StaticResource AmberBorder}"
                                                               Text="ALREADY ASSIGNED" />
                                                    <Button Grid.Column="5"
                                                            Content="{Binding ButtonLabel}"
                                                            IsEnabled="{Binding CanAssign}"
                                                            Style="{StaticResource MainButton}"
                                                            Click="btnAssignEquipment_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </PivotItem>
        </Pivot>

        <!-- Footer -->
        <Grid Grid.Row="2" Padding="16,8,16,12"
              Background="{StaticResource PanelBg}"
              BorderBrush="{StaticResource AmberBorder}" BorderThickness="0,2,0,0">
            <Button Style="{ThemeResource MainButton}" Content="◀  Return to HQ" Click="btnBack_Click" />
        </Grid>
        </Grid>
    </Grid>
</Page>
