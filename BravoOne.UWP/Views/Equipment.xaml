<Page
    x:Class="BravoOne.UWP.Views.Equipment"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BravoOne.UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource AppBg}">
        <Grid Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="16,10,16,10" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource AmberBorder}" BorderThickness="0,0,0,2">
                <TextBlock Style="{StaticResource Header}" Text="ARMORY" />
            </Grid>

            <Grid Grid.Row="1" Margin="16,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ListView Grid.Column="0" SelectionMode="None"
                          ItemsSource="{Binding gWrapper.CurrentGame.AvailableEquipment}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,3,0,3"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8" Padding="12,10,12,10"
                                  Background="{StaticResource ItemBg}"
                                  BorderBrush="{StaticResource AmberBorder}" BorderThickness="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                       MaxHeight="96" MaxWidth="96" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding ImagePath}" />
                                    </Image.Source>
                                </Image>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Name}" Style="{StaticResource ListViewHeader}" />

                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CLASS" Style="{StaticResource FieldHeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="5,0,12,0" Text="{Binding EType}" Style="{StaticResource FieldValue}" />

                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="COST" Style="{StaticResource FieldHeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="5,0,12,0" Text="{Binding Cost}" Style="{StaticResource FieldValue}" Foreground="{StaticResource PhosphorGreen}" />

                                    <TextBlock Grid.Row="0" Grid.Column="4" Text="REQ LVL" Style="{StaticResource FieldHeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="5" Margin="5,0,12,0" Text="{Binding RequiredLevel}" Style="{StaticResource FieldValue}" />

                                    <TextBlock Grid.Row="0" Grid.Column="6" Text="DMG" Style="{StaticResource FieldHeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="7" Margin="5,0,12,0" Text="{Binding Damage}" Style="{StaticResource FieldValue}" Foreground="{StaticResource AlertRed}" />

                                    <TextBlock Grid.Row="0" Grid.Column="8" Text="REL" Style="{StaticResource FieldHeader}" />
                                    <TextBlock Grid.Row="0" Grid.Column="9" Margin="5,0,0,0" Text="{Binding Reliability}" Style="{StaticResource FieldValue}" Foreground="{StaticResource ColdBlue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="10" Margin="0,4,0,0" Text="{Binding Comments}" Style="{StaticResource FieldValue}" Foreground="{StaticResource AmberDim}" TextWrapping="Wrap" />
                                </Grid>

                                <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                        VerticalAlignment="Center" Margin="12,0,0,0"
                                        Style="{StaticResource MainButton}"
                                        IsEnabled="{Binding Available}"
                                        Content="PURCHASE" Click="btnPurchase_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Right">
                    <Image Source="/Assets/SidePanels/Armory.png" Stretch="Uniform" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Padding="16,10,16,10">
                <Button Style="{StaticResource MainButton}" Content="RETURN TO MAIN SCREEN" Click="btnBack_Click" />
            </Grid>
        </Grid>

        <Rectangle IsHitTestVisible="False" Opacity="0.28">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,0.05" SpreadMethod="Repeat">
                    <GradientStop Color="#33000000" Offset="0.0" />
                    <GradientStop Color="#33000000" Offset="0.49" />
                    <GradientStop Color="#00000000" Offset="0.5" />
                    <GradientStop Color="#00000000" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</Page>
