<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════
         COLD WAR // BRAVO ONE  —  CRT TERMINAL PALETTE
         Primary amber  : #FFB000   Dim amber   : #AA7700
         Panel bg       : #110E00   Item bg     : #1C1600
         Border amber   : #664400   Border hot  : #FFB000
         Phosphor green : #44FF55   Alert red   : #FF4400
         Cold blue      : #44AAFF
    ═══════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="AmberPrimary"  Color="#FFB000" />
    <SolidColorBrush x:Key="AmberDim"      Color="#AA7700" />
    <SolidColorBrush x:Key="AmberBorder"   Color="#664400" />
    <SolidColorBrush x:Key="PhosphorGreen" Color="#44FF55" />
    <SolidColorBrush x:Key="AlertRed"      Color="#FF4400" />
    <SolidColorBrush x:Key="ColdBlue"      Color="#44AAFF" />
    <SolidColorBrush x:Key="PanelBg"       Color="#110E00" />
    <SolidColorBrush x:Key="ItemBg"        Color="#1C1600" />
    <SolidColorBrush x:Key="AppBg"         Color="#0A0800" />

    <Style TargetType="Button" x:Key="MainButton">
        <Setter Property="FontFamily" Value="Fonts/MainFont.ttf#Tudor Victors" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="Background" Value="#1C1600" />
        <Setter Property="Foreground" Value="#FFB000" />
        <Setter Property="BorderBrush" Value="#664400" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6,14,6" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Header">
        <Setter Property="FontFamily" Value="Fonts/MainFont.ttf#Tudor Victors" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="Foreground" Value="#FFB000" />
        <Setter Property="Margin" Value="10,16,0,0" />
    </Style>

    <Style TargetType="TextBlock" x:Key="SubHeader">
        <Setter Property="FontFamily" Value="Fonts/MainFont.ttf#Tudor Victors" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="#AA7700" />
    </Style>

    <Style TargetType="TextBlock" x:Key="ListViewHeader">
        <Setter Property="FontFamily" Value="Fonts/MainFont.ttf#Tudor Victors" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="#FFB000" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldHeader">
        <Setter Property="FontFamily" Value="Fonts/MainFont.ttf#Tudor Victors" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#AA7700" />
    </Style>

    <Style TargetType="TextBlock" x:Key="FieldValue">
        <Setter Property="FontFamily" Value="Fonts/MainFont.ttf#Tudor Victors" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFB000" />
    </Style>

    <!-- Pivot header override for terminal look -->
    <Style TargetType="PivotItem">
        <Setter Property="Margin" Value="0" />
    </Style>

</ResourceDictionary>